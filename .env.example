# Server Configuration
PORT=3001
NODE_ENV=development

# Allowed CORS Origins (comma-separated URLs, no wildcards in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Live Email Delivery (Nodemailer SMTP Configuration)
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-google-app-password
# SMTP_FROM="HATAK R Portal <no-reply@hatak-r.com>"
# CONTACT_NOTIFICATION_EMAIL=contact@hatak-r.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HATAK R Inquiries <no-reply@hatak-r.com>"
CONTACT_NOTIFICATION_EMAIL=contact@hatak-r.com
